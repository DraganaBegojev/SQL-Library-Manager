extends layout

block content
  .books-container
    h1 Books
    // search form
    form(action='/books', method='GET')
      input(type='text' name='search' placeholder='Search books...', value=searchQuery)
      button(type="submit") Search


    p
      a.button(href="/books/new") Create New Book
    table
      thead
        tr
          th Title
          th Author
          th Genre
          th Year
      tbody
        each book in books
          tr
            td
              a(href=`/books/${book.id}`)= book.title
            td= book.author
            td= book.genre
            td= book.year
    // pagination controls
    if totalPages > 1
      .pagination
        if currentPage > 1
          a(href=`/books?page=${currentPage - 1}&search=${searchQuery || ''}`) Previous
        else
          span Previous
        |  
        span Page #{currentPage} of #{totalPages}
        |  
        if currentPage < totalPages
          a(href=`/books?page=${currentPage + 1}&search=${searchQuery || ''}`) Next
        else
          span Next

